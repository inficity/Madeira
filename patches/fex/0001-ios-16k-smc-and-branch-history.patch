 bool InvalidationTracker::ProtectRWXIntervalsInternal(uint64_t Address, uint64_t Size, bool ForWriteLocked) {
+#ifdef FEX_IOS_HOST
+  /* ml1307: trap and untrap whole 16 KB host pages. Wine gives a host page the UNION
+   * of its four guest pages' protections, so trapping only the 4 KB page that holds
+   * the code left the host page writable whenever a neighbour was: CoreCLR keeps
+   * precodes and data side by side, its code writes never faulted, and translations
+   * of patched precodes went stale (ThePreStub loop). */
+  {
+    const uint64_t HostEnd = (Address + Size + IosHostPageSize - 1) & ~uint64_t {IosHostPageSize - 1};
+    Address &= ~uint64_t {IosHostPageSize - 1};
+    Size = HostEnd - Address;
+  }
+#endif
   const auto End = Address + Size;
   std::shared_lock Lock(IntervalsLock);
 
